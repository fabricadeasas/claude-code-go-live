{
  "description": "Mantém as preferências da Fábrica de Asas no Ar em ~/.claude/rules/fabrica-de-asas-no-ar/ atualizadas e bloqueia qualquer mudança na produção (main/master) que não venha por um pedido de junção (pull request) da dev.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/preferences.sh\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-production.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
